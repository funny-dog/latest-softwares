# Web 构建产物（CI 临时生成，不入库）
# 注意：dist/ 不能放在 .gitignore 中，否则 fastapi deploy 会排除它
# dist/ 的 git 忽略通过 .git/info/exclude 实现（仅本地生效）

# 一次性批量导入脚本不属于同步/部署运行链路
scripts/add_*.py

# 链接巡检报告由 CI artifact 保存，本地运行时不入库
data/link-health.json

# 结构化同步日志（运行时追加，不入库）
data/sync_errors.jsonl

# discover 管道运行时产出的新 id 列表（供 workflow 消费，不入库）
discover_new_ids.txt

# SQLite 运行时数据库（FastAPI Cloud 临时存储，不入库）
data/site_metrics.db

# GitHub API 条件请求缓存（LATEST_SOFTWARES_HTTP_CACHE）
.cache/

# Node.js
node_modules/

# 前端构建产物
web/dist/

